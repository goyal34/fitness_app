# Copy this file to .env and change the values for your machine.
#
#   Copy-Item .env.example .env
#
# The start-all script loads .env automatically. Values already present in
# your shell environment take precedence over the ones in this file.

# PostgreSQL (used by the User Service)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Google Gemini (used by the AI Service). Without a key the service still
# starts, but recommendations cannot be generated.
GEMINI_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-3.6-flash:generateContent?key=
GEMINI_API_KEY=your-gemini-api-key-here

# Keycloak development administrator. Used only once to create the
# fitness-oauth2 realm and the demo testuser/test1234 account.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Timezone passed to every Spring Boot JVM. Keep an explicit IANA zone here if
# PostgreSQL runs in a container and rejects the JVM's default zone.
APP_TIMEZONE=Asia/Kolkata
